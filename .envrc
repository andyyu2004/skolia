# direnv: the flake's dev shell, and environment the tools need. wrangler dev's own
# settings are in api/.env and api/.env.local, not here.
use flake

# wrangler warns about local_dev.experimental_s3_credentials (wrangler.jsonc) each time it reads the config
export WRANGLER_DISABLE_EXPERIMENTAL_WARNING=1

# sops on macOS looks for the age key in ~/Library/Application Support; point it at
# ~/.config's if that's where it is
if [ -z "${SOPS_AGE_KEY_FILE:-}" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt" ]; then
  export SOPS_AGE_KEY_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt
fi
