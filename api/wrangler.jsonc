// skolia on Cloudflare: one Worker serves the reader (static assets) and the API.
// In production Terraform (infra/) deploys it; this file is for wrangler dev, building
// the bundle Terraform uploads (wrangler deploy --dry-run --outdir dist), and D1
// migrations. Ingest is a separate Worker: wrangler.ingest.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia",
  "main": "src/worker/main.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "../reader/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skolia",
      // terraform -chdir=infra output -raw d1_database_id
      "database_id": "e9c02964-6266-463f-9d7a-ce71a33f3b98",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "skolia",
      // wrangler dev serves the local bucket over S3 for the ingest container, at
      // /cdn-cgi/local/r2/s3/skolia, with these credentials (api/.env)
      "local_dev": {
        "experimental_s3_credentials": { "accessKeyId": "skolia-dev", "secretAccessKey": "skolia-dev" }
      }
    }
  ],
  // In production Terraform sets it (var.max_imports_per_day)
  "vars": { "MAX_IMPORTS_PER_DAY": "50" },
  "queues": {
    "producers": [{ "binding": "INGEST", "queue": "skolia-ingest" }]
  },
  // Bindings aren't inherited, so each environment lists its own (Terraform's names)
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "skolia-staging",
          // infra/tf.sh staging output -raw d1_database_id
          "database_id": "fcffbf4c-49da-4a60-b85b-c6ccabd225a1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-staging" }],
      "vars": { "MAX_IMPORTS_PER_DAY": "50" },
      "queues": {
        "producers": [{ "binding": "INGEST", "queue": "skolia-ingest-staging" }]
      }
    }
  }
}
