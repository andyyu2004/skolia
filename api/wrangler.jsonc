// skolia on Cloudflare: one Worker serves the reader (static assets) and the API.
// Deployed with wrangler (infra/wrangler.sh <env> deploy), which also applies the
// Durable Object migrations. Terraform (infra/) makes the D1 database, R2 bucket and
// queue it binds. The top level is production and wrangler dev; staging is env.staging.
// Ingest is a separate Worker: wrangler.ingest.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia",
  "main": "src/worker/main.ts",
  "compatibility_date": "2026-10-19",
  "minify": true,
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "skolia.io", "custom_domain": true }],
  // wrangler dev would otherwise rewrite each request's Host to the route's, and the
  // ingest container's S3 requests, signed for localhost:8787, would fail
  "dev": { "host": "localhost:8787" },
  // just deploy-web overrides it with git describe
  "define": { "VERSION": "\"dev\"" },
  "assets": {
    "directory": "../reader/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skolia",
      "migrations_dir": "migrations"
    },
    {
      "binding": "LEXICON_EN",
      "database_name": "skolia-lexicon-en",
      "migrations_dir": "lexicon-migrations"
    },
    {
      "binding": "LEXICON_PL",
      "database_name": "skolia-lexicon-pl",
      "migrations_dir": "lexicon-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "skolia",
      // wrangler dev serves the local bucket over S3 for the ingest container, at
      // /cdn-cgi/local/r2/s3/skolia, with these credentials (api/.env)
      "local_dev": {
        "experimental_s3_credentials": { "accessKeyId": "skolia-dev", "secretAccessKey": "skolia-dev" }
      }
    }
  ],
  // MAX_IMPORTS_PER_DAY: new texts the API accepts per UTC day, across all users;
  // analysis time is the main cost. wrangler dev takes BASE_URL from api/.env, and the
  // auth secrets from api/.env.local (DEVELOP.md); deployed, they're wrangler secrets.
  "vars": { "MAX_IMPORTS_PER_DAY": "50", "BASE_URL": "https://skolia.io" },
  "queues": {
    "producers": [{ "binding": "INGEST", "queue": "skolia-ingest" }]
  },
  // INGESTER: the ingest Worker's (wrangler.ingest.jsonc), asked where a document is in
  // its queue
  "durable_objects": {
    "bindings": [
      { "name": "USER", "class_name": "User" },
      { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["User"] }],
  // Bindings and routes aren't inherited, so each environment lists its own (Terraform's
  // names). Wrangler looks D1 databases up by name, and creates one it can't find, so
  // Terraform must make it first (just deploy-infra). Deployed as skolia-staging.
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.skolia.io", "custom_domain": true }],
      "define": { "VERSION": "\"dev\"" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "skolia-staging",
          "migrations_dir": "migrations"
        },
        {
          "binding": "LEXICON_EN",
          "database_name": "skolia-lexicon-en-staging",
          "migrations_dir": "lexicon-migrations"
        },
        {
          "binding": "LEXICON_PL",
          "database_name": "skolia-lexicon-pl-staging",
          "migrations_dir": "lexicon-migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "skolia-staging" }],
      "vars": { "MAX_IMPORTS_PER_DAY": "50", "BASE_URL": "https://staging.skolia.io" },
      "queues": {
        "producers": [{ "binding": "INGEST", "queue": "skolia-ingest-staging" }]
      },
      "durable_objects": {
        "bindings": [
          { "name": "USER", "class_name": "User" },
          { "name": "INGESTER", "class_name": "Ingester", "script_name": "skolia-ingest-staging" }
        ]
      }
    }
  }
}
