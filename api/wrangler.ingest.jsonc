// skolia-ingest: the queue consumer and its analysis containers, one per language
// (src/worker/ingest.ts). Deployed with wrangler, since Terraform's Cloudflare provider
// has no container resource. The queue itself is created by Terraform (infra/).
// infra/deploy-ingest.sh puts each class's pushed image in place of the Dockerfile.
//
// Secrets (from terraform output): S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY. See
// infra/README.md for the deploy command.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia-ingest",
  "main": "src/worker/ingest.ts",
  "compatibility_date": "2026-10-19",
  // No HTTP handler: it only consumes the queue
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "IngestPl",
      "image": "../analysis/Dockerfile",
      "image_build_context": "..",
      "image_vars": { "SKOLIA_LANG": "pl" },
      // 1 vCPU, 6 GiB: Polish ingest peaked at 4.3 GiB on a 2,800-word text (in Docker)
      "instance_type": "standard-2",
      "max_instances": 1
    },
    {
      "class_name": "IngestEn",
      "image": "../analysis/Dockerfile",
      "image_build_context": "..",
      "image_vars": { "SKOLIA_LANG": "en" },
      // English ingest peaked at 4.7 GiB on the same text; the two
      // languages in one container peaked at 6.7 GiB
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "INGEST_PL", "class_name": "IngestPl" },
      { "name": "INGEST_EN", "class_name": "IngestEn" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ingest"] },
    // Ingest was Polish's before there were other languages; its container application
    // isn't deleted with it (wrangler containers delete)
    { "tag": "v2", "deleted_classes": ["Ingest"], "new_sqlite_classes": ["IngestPl", "IngestEn"] }
  ],
  "queues": {
    "consumers": [{ "queue": "skolia-ingest", "max_batch_size": 10, "max_retries": 10 }]
  },
  // S3_ENDPOINT is passed at deploy (--var, terraform output r2_s3_endpoint) and
  // locally in .env
  "vars": { "S3_BUCKET": "skolia" },
  // Deployed as skolia-ingest-staging. Bindings and containers aren't inherited.
  "env": {
    "staging": {
      "containers": [
        {
          "class_name": "IngestPl",
          "image": "../analysis/Dockerfile",
          "image_build_context": "..",
          "image_vars": { "SKOLIA_LANG": "pl" },
          "instance_type": "standard-2",
          "max_instances": 1
        },
        {
          "class_name": "IngestEn",
          "image": "../analysis/Dockerfile",
          "image_build_context": "..",
          "image_vars": { "SKOLIA_LANG": "en" },
          "instance_type": "standard-2",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "INGEST_PL", "class_name": "IngestPl" },
          { "name": "INGEST_EN", "class_name": "IngestEn" }
        ]
      },
      "queues": {
        "consumers": [{ "queue": "skolia-ingest-staging", "max_batch_size": 10, "max_retries": 10 }]
      },
      "vars": { "S3_BUCKET": "skolia-staging" }
    }
  }
}
