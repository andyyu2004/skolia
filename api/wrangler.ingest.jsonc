// skolia-ingest: the queue consumer and its analysis containers, one per language and image
// (src/worker/ingest.ts). Deployed with wrangler, since Terraform's Cloudflare provider
// has no container resource. The queue itself is created by Terraform (infra/).
//
// Secrets (from terraform output): S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY. See
// infra/README.md for the deploy command.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skolia-ingest",
  "main": "src/worker/ingest.ts",
  "compatibility_date": "2026-10-19",
  // No HTTP handler: it only consumes the queue
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // One container application, whose Ingesters start each language's image
  // (src/worker/ingest.ts). infra/deploy-ingest.sh puts the pushed images, pinned by
  // digest, in place of the Dockerfiles, which are for wrangler dev.
  "containers": [
    {
      "name": "skolia-ingest",
      "class_name": "Ingester",
      "scheduling_policy": "durable_object",
      // Not inherited from the Worker's for this policy
      "observability": { "logs": { "enabled": true } },
      "images": {
        "pl": { "dockerfile": "../analysis/image/Dockerfile", "build_vars": { "SKOLIA_LANG": "pl" } },
        "en": { "dockerfile": "../analysis/image/Dockerfile", "build_vars": { "SKOLIA_LANG": "en" } },
        "fr": { "dockerfile": "../analysis/image/Dockerfile", "build_vars": { "SKOLIA_LANG": "fr" } }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "INGESTER", "class_name": "Ingester" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ingest"] },
    // Ingest was Polish's before there were other languages; its container application
    // isn't deleted with it (wrangler containers delete)
    { "tag": "v2", "deleted_classes": ["Ingest"], "new_sqlite_classes": ["IngestPl", "IngestEn"] },
    // The default scheduling policy's classes, one per language; their container
    // applications aren't deleted with them either
    { "tag": "v3", "deleted_classes": ["IngestPl", "IngestEn"], "new_sqlite_classes": ["Ingester"] }
  ],
  "queues": {
    "consumers": [{ "queue": "skolia-ingest", "max_batch_size": 10, "max_retries": 10 }]
  },
  // S3_ENDPOINT is passed at deploy (--var, terraform output r2_s3_endpoint) and
  // locally in .env
  "vars": { "S3_BUCKET": "skolia" },
  // Deployed as skolia-ingest-staging. Bindings and containers aren't inherited.
  "env": {
    "staging": {
      "containers": [
        {
          "name": "skolia-ingest-staging",
          "class_name": "Ingester",
          "scheduling_policy": "durable_object",
          // Not inherited from the Worker's for this policy
          "observability": { "logs": { "enabled": true } },
          "images": {
            "pl": { "dockerfile": "../analysis/image/Dockerfile", "build_vars": { "SKOLIA_LANG": "pl" } },
            "en": { "dockerfile": "../analysis/image/Dockerfile", "build_vars": { "SKOLIA_LANG": "en" } },
            "fr": { "dockerfile": "../analysis/image/Dockerfile", "build_vars": { "SKOLIA_LANG": "fr" } }
          }
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "INGESTER", "class_name": "Ingester" }]
      },
      "queues": {
        "consumers": [{ "queue": "skolia-ingest-staging", "max_batch_size": 10, "max_retries": 10 }]
      },
      "vars": { "S3_BUCKET": "skolia-staging" }
    }
  }
}
