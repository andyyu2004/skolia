// Test-only consumer of the local ingest queue, so tests can see what the API queued
{
  "name": "ingest-recorder",
  "main": "ingest-recorder.ts",
  "compatibility_date": "2026-10-19",
  "queues": {
    "consumers": [{ "queue": "skolia-ingest", "max_batch_size": 100, "max_batch_timeout": 0 }]
  }
}
