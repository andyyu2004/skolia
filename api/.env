# For wrangler dev (just dev), which loads it for both Workers: the ingest container reaches the local R2 bucket
# through the dev server's S3 endpoint (local_dev in wrangler.jsonc). Not secrets.
S3_ENDPOINT=http://host.docker.internal:8787/cdn-cgi/local/r2/s3
# wrangler dev answers /cdn-cgi/ only for localhost
S3_HOST=localhost:8787
S3_ACCESS_KEY_ID=skolia-dev
S3_SECRET_ACCESS_KEY=skolia-dev
SLEEP_AFTER=30s
# The reader's Vite server, in place of wrangler.jsonc's https://skolia.io (sign-in redirects)
BASE_URL=http://localhost:5173
# Signs local sessions only. Deployed, each environment has its own (Terraform's better_auth_secret).
BETTER_AUTH_SECRET=skolia-dev-only-secret-not-used-anywhere-deployed
