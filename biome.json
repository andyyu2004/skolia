{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!pnpm-lock.yaml", "!shared/schema.gen.ts", "!reader/screenshots/fixtures", "!**/*.md", "!**/*.svg"] },
  "formatter": { "indentStyle": "space", "lineWidth": 140 },
  "html": {
    "formatter": { "enabled": true, "indentScriptAndStyle": true, "whitespaceSensitivity": "strict" },
    "experimentalFullSupportEnabled": true
  },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
